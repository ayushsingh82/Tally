# ---- Chain (HashKey Chain Testnet; mainnet is chain 177) ----
CHAIN_RPC_URL=https://testnet.hsk.xyz
CHAIN_ID=133
CHAIN_NAME=HashKey Chain Testnet
# Set by scripts/testnet-setup.ts after it deploys the vault
VAULT_ADDRESS=
# Signs registerSeller / advance / sweep / flagDefault
UNDERWRITER_PRIVATE_KEY=

# ---- HSP (https://hashkey-merchant.github.io/docs/en/) ----
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_MERCHANT_NAME=Float
# Payment method on each mandate (hashkey-testnet USDC)
HSP_NETWORK=hashkey-testnet
HSP_CHAIN_ID=133
HSP_TOKEN_ADDRESS=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
HSP_COIN=USDC
# Arrive after merchant registration. Without them the dashboard still reads the vault, but cannot create orders
HSP_APP_KEY=
HSP_APP_SECRET=
# secp256k1 PEM (PKCS8 or SEC1); use \n for newlines in a single-line value
HSP_JWT_PRIVATE_KEY=

# ---- Access ----
# Operator console passcode, 12+ characters. Without it nobody can sign in
DASHBOARD_PASSCODE=
# Bearer token for the /api routes, 16+ characters
API_TOKEN=
DENY_LIST=
ALLOW_LIST=
DATA_FILE=.data/state.json
RECEIPTS_FILE=.data/receipts.jsonl

# ---- Testnet scripts (scripts/check-funds.ts, testnet-setup.ts, testnet-flow.ts) ----
# Generated wallet keys, testnet only
DEPLOYER_PRIVATE_KEY=
LP_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
POOL_USDC=100
RESERVE_USDC=20
BUYER_USDC=50
MAX_ADVANCE_USDC=50
MIN_HSK=0.02
